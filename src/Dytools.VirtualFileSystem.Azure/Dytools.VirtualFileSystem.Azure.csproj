<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Dytools.VirtualFileSystem.Nodes.Azure</RootNamespace>
    <AssemblyName>Dytools.VirtualFileSystem.Azure</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Dytools.VirtualFileSystem.Azure</PackageId>
    <Title>Dytools Virtual File System - Azure Blob Storage provider</Title>
    <Description>Azure Blob Storage node for Dytools.VirtualFileSystem. Mount a blob container under a VFS path and read, write, list, copy, and delete blobs through the unified virtual filesystem API. Uses Azure.Storage.Blobs.</Description>
    <PackageTags>vfs;virtual-filesystem;azure;azure-blob;blob-storage;storage;streams</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dytools.VirtualFileSystem\Dytools.VirtualFileSystem.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.1" />
  </ItemGroup>

</Project>
